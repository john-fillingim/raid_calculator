---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';

type Props = {
  title: string;
  description: string;
  /** Path of the OG image under /og/, without extension. */
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
  wide?: boolean;
};

const { title, description, ogImage = 'home', jsonLd, wide = true } = Astro.props;
const site = Astro.site ?? new URL('https://raid-calculator.example');
const canonical = new URL(Astro.url.pathname, site).href;
const ogUrl = new URL(`/og/${ogImage}.png`, site).href;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/', label: 'Calculator' },
  { href: '/compare', label: 'Compare' },
  { href: '/raid', label: 'RAID levels' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#fbfbfc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0c0f" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      (function () {
        let pref = 'system';
        try {
          pref = localStorage.getItem('raid-calc:theme') || 'system';
        } catch {
          // Storage blocked: fall back to the system preference.
        }
        const dark =
          pref === 'dark' ||
          (pref !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.documentElement.dataset.themePref = pref;
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col bg-bg text-text antialiased">
    <a
      href="#main"
      class="sr-only z-50 rounded-md bg-accent px-3 py-2 text-accent-fg focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to content
    </a>
    <header class="sticky top-0 z-30 border-b border-border bg-bg/85 backdrop-blur-md">
      <div
        class:list={[
          'mx-auto flex h-14 items-center gap-6 px-4 sm:px-6',
          wide ? 'max-w-[1360px]' : 'max-w-5xl',
        ]}
      >
        <a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight text-text">
          <svg width="22" height="22" viewBox="0 0 32 32" aria-hidden="true">
            <rect x="2" y="2" width="28" height="28" rx="7" fill="var(--accent)"></rect>
            <rect x="8" y="8" width="4" height="16" rx="1.5" fill="var(--accent-fg)"></rect>
            <rect x="14" y="8" width="4" height="16" rx="1.5" fill="var(--accent-fg)"></rect>
            <rect x="20" y="8" width="4" height="10" rx="1.5" fill="var(--accent-fg)"></rect>
            <rect
              x="20"
              y="20"
              width="4"
              height="4"
              rx="1.5"
              fill="var(--accent-fg)"
              opacity="0.55"
            ></rect>
          </svg>
          <span>RAID Calculator</span>
        </a>
        <nav aria-label="Main" class="ml-auto flex items-center gap-1 text-sm">
          {nav.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'hidden rounded-md px-3 py-2 transition-colors duration-150 sm:inline-block',
                isActive(item.href)
                  ? 'bg-surface-2 text-text'
                  : 'text-text-2 hover:bg-surface-2 hover:text-text',
              ]}
            >
              {item.label}
            </a>
          ))}
          <ThemeToggle />
        </nav>
      </div>
      <nav
        aria-label="Main mobile"
        class="no-scrollbar flex gap-1 overflow-x-auto border-t border-border px-3 py-1.5 text-sm sm:hidden"
      >
        {nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'flex min-h-11 items-center rounded-md px-3',
              isActive(item.href) ? 'bg-surface-2 text-text' : 'text-text-2',
            ]}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </header>
    <main id="main" class="flex-1">
      <slot />
    </main>
    <footer class="mt-16 border-t border-border">
      <div
        class:list={[
          'mx-auto flex flex-col gap-3 px-4 py-8 text-sm text-text-3 sm:flex-row sm:items-center sm:justify-between sm:px-6',
          wide ? 'max-w-[1360px]' : 'max-w-5xl',
        ]}
      >
        <p>
          Figures are theoretical. Real arrays lose a little to metadata, controller overhead and
          filesystem formatting.
        </p>
        <p class="flex gap-4">
          <a href="/raid" class="hover:text-text">
            RAID levels
          </a>
          <a href="/compare" class="hover:text-text">
            Compare
          </a>
        </p>
      </div>
    </footer>
  </body>
</html>
